  "production": {
    "narrationLanguage": "English",
    "captionsRequired": true,
    "soundEffectsRequired": true,
    "originalStorySpecificArtworkRequired": true,
    "voiceConsistencyRequired": true,
    "nativePortraitCompositionRequired": true,
    "automatedTechnicalChecksRequired": true,
    "humanApprovalRequired": true,
    "autoPublishWithoutApproval": false
  },
  "workflow": {
    "states": [
      "IDEA",
      "RESEARCHED",
      "SCRIPTED",
      "VOICE_READY",
      "SCENES_READY",
      "RENDERED",
      "QC_FAILED",
      "NEEDS_APPROVAL",
      "APPROVED",
      "SCHEDULED",
      "PUBLISHED"
    ],
    "maxAutomaticRetries": 1,
