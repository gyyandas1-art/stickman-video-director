{
  "channel": {
    "name": "Psychology Stickman Shorts",
    "language": "en",
    "niche": "psychology",
    "format": "youtube-shorts",
    "style": "B1",
    "ratio": "9:16",
    "width": 720,
    "height": 1280,
    "fps": 30,
    "targetDurationSeconds": {
      "min": 45,
      "max": 60
    },
    "uploadsPerWeek": 3,
    "timezone": "Asia/Kolkata",
