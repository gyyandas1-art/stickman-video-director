{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stickman-comedy-episode.schema.json",
  "title": "Stickman Comedy Meme Episode",
  "type": "object",
  "required": ["title", "premise", "hook", "setup", "escalation", "punchline", "characters", "shots", "audio", "review_status"],
  "properties": {
    "title": {"type": "string", "minLength": 4, "maxLength": 80},
    "premise": {"type": "string", "minLength": 12, "maxLength": 220},
    "hook": {"type": "string", "minLength": 5, "maxLength": 160},
    "setup": {"type": "string", "minLength": 5},
    "escalation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "punchline": {"type": "string", "minLength": 5},
    "characters": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "description", "palette"], "properties": {"id": {"type": "string"}, "description": {"type": "string"}, "palette": {"type": "array", "items": {"type": "string"}}}}},
    "shots": {"type": "array", "minItems": 6, "maxItems": 20, "items": {"type": "object", "required": ["start", "end", "framing", "action", "expression", "prop_state", "background", "transition"], "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}, "framing": {"type": "string"}, "action": {"type": "string"}, "expression": {"type": "string"}, "prop_state": {"type": "string"}, "background": {"type": "string"}, "transition": {"type": "string"}, "character_ids": {"type": "array", "items": {"type": "string"}}, "on_screen_text": {"type": "string", "maxLength": 48}}}},
    "audio": {"type": "object", "required": ["voiceover", "music", "effects"], "properties": {"voiceover": {"type": "string"}, "music": {"type": "string"}, "effects": {"type": "array", "items": {"type": "object", "required": ["time", "cue", "rights_note"], "properties": {"time": {"type": "number"}, "cue": {"type": "string"}, "rights_note": {"type": "string"}}}}}},
    "review_status": {"enum": ["DRAFT", "REVIEW_REQUIRED", "APPROVED", "REJECTED"]}
  },
  "additionalProperties": false
}
